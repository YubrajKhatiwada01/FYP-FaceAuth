# Flask Configuration
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here

# Server Configuration
# For local development:
#   FLASK_HOST=127.0.0.1
# For EC2 / server deployment (accessible from outside):
#   FLASK_HOST=0.0.0.0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Security
SESSION_COOKIE_SECURE=False

# WebAuthn settings
# For local development, leave these commented — they are auto-detected.
# For EC2 deployment, set these to your EC2 Public IP:
#   RP_ID=<YOUR-EC2-PUBLIC-IP>
#   RP_NAME=FaceAuth
#   ORIGIN=http://<YOUR-EC2-PUBLIC-IP>:5000
# For a real domain:
#   RP_ID=yourdomain.com
#   RP_NAME=FaceAuth
#   ORIGIN=https://yourdomain.com

# Note: In production, also set:
# - FLASK_ENV=production
# - DEBUG=False
# - SESSION_COOKIE_SECURE=True  (only when using HTTPS)
# - SECRET_KEY to a strong random string

# ── AWS IoT Core (ESP32 door unlock) ─────────────────────────────────────────
# Find your endpoint in the AWS IoT Console → Settings → Device data endpoint
# Example: abcdefg12345-ats.iot.us-east-1.amazonaws.com
IOT_ENDPOINT=
# Must match the region where your IoT Core is provisioned
AWS_REGION=us-east-1

# ── Push Authentication (Magic Link / HTML Email Button) ─────────────────────
# Replace with your AWS API Gateway trigger URL (hits Lambda to open ESP32 door)
AWS_DOOR_UNLOCK_URL=YOUR_AWS_API_URL_HERE

# ── Gmail SMTP Configuration (Push Email with Google App Password) ────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
